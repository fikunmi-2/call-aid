# The site/examples work without credentials; voice fails closed until configured.
APP_ORIGIN=http://localhost:3000
DEMO_ENABLED=false
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=call-aid
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Generate at least 32 random bytes. Server only.
SESSION_HMAC_SECRET=
MAX_CALL_SECONDS=180
MAX_CONCURRENT_SESSIONS=1
MAX_STARTS_10_MINUTES=2
MAX_STARTS_PER_DAY=5
MAX_GLOBAL_STARTS_PER_DAY=10
MAX_DAILY_VOICE_SECONDS=900
MONTHLY_BUDGET_MICRODOLLARS=2000000
# Conservative reservation estimate, NOT a guaranteed token-based spend cap.
RESERVED_COST_MICRODOLLARS=150000
